        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pool, state) (vora_pool_sandboxes)",
          "legendFormat": "{{pool}} {{state}}"
        }
      ],
      "description": "Not exported yet: this panel uses the warm-pool design's metric names, and Vora adds them in build step 13. It stays empty until then and has never been checked against a real pool."
    },
